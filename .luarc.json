{
    "$schema": "https://raw.githubusercontent.com/LuaLS/lua-language-server/master/doc/en-us/config.md",
    "runtime": {
        "version": "Lua 5.1",
        "special": {
            "require": "require"
        }
    },
    "diagnostics": {
        "globals": ["Jade"],
        "disable": ["lowercase-global"]
    },
    "workspace": {
        "library": [
            "src/jade/types"
        ],
        "checkThirdParty": false
    },
    "completion": {
        "callSnippet": "Replace",
        "keywordSnippet": "Replace",
        "displayContext": 6
    },
    "hover": {
        "enable": true,
        "fieldsLimit": 20
    },
    "format": {
        "enable": true
    }
}

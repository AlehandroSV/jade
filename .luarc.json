{
    "runtime": {
        "version": "LuaJIT"
    },
    "diagnostics": {
        "globals": ["vim", "jit", "unpack", "table"]
    },
    "workspace": {
        "library": [
            "src/jade",
            "${workspaceFolder}/src"
        ],
        "ignoreDir": ["/%.git"],
        "checkThirdParty": "Disabled"
    },
    "unusedLocalExclude": ["_*"],
    "format": {
        "enable": true,
        "defaultConfig": {
            "indent_style": "spaces",
            "indent_size": 4
        }
    }
}
